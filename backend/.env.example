# Server
PORT=3001

# OpenAI — required for live GPT-4o conversations
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Set to true to run without OpenAI (keyword mock seller)
USE_MOCK_AI=false

# TTS: 'browser' (free, Web Speech API) | 'elevenlabs' (premium voice)
TTS_ENGINE=browser

# Optional — only needed when TTS_ENGINE=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
